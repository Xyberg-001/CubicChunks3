{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.opencubicchunks.cubicchunks.CubicChunks"],
    "client": ["io.github.opencubicchunks.cubicchunks.client.CubicChunksClient"]
  },
  "mixins": [
    "dasm-fabric.mixins.json",
    "cubicchunks.mixins.core.json",
    "cubicchunks.mixins.access.json",
    "cubicchunks.mixins.sodium.json"
  ],
  "accessWidener": "cubicchunks.accesswidener",
  "custom": {
    "dasm": ["cubicchunks.dasm.json"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
